{
  "expo": {
    "name": "Connect",
    "slug": "lorem",
    "version": "2.1.6",
    "scheme": "connect",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#29B1A9"
    },
    "assetBundlePatterns": [
      "assets/**",
      "src/assets/**"
    ],
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.connect.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to save and play downloaded videos.",
        "NSPhotoLibraryAddUsageDescription": "This app saves downloaded YouTube videos to your Photos library.",
        "NSCameraUsageDescription": "This app uses the camera to take photos and videos.",
        "NSMicrophoneUsageDescription": "This app uses the microphone to record audio.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "googleusercontent.com": {
              "NSIncludesSubdomains": true,
              "NSExceptionRequiresForwardSecrecy": false
            },
            "ggpht.com": {
              "NSIncludesSubdomains": true,
              "NSExceptionRequiresForwardSecrecy": false
            }
          }
        },
        "UIBackgroundModes": [
          "audio",
          "background-fetch",
          "background-processing",
          "remote-notification",
          "voip"
        ]
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.connect.app",
      "versionCode": 216,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-font",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "kotlinVersion": "2.1.20",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-camera",
      "expo-location",
      "expo-file-system",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true,
          "sounds": [
            "./src/assets/audio/ringtone_1.mp3",
            "./src/assets/audio/ringtone_2.mp3",
            "./src/assets/audio/ringtone_3.mp3",
            "./src/assets/audio/ringtone_4.mp3",
            "./src/assets/audio/ringtone_5.mp3",
            "./src/assets/audio/default_ringtone.mp3"
          ]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Connect to access your photos and videos so downloaded files can be saved and played.",
          "savePhotosPermission": "Allow Connect to save downloaded videos to Photos and Gallery.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "video",
            "audio",
            "photo"
          ]
        }
      ],
      "expo-task-manager",
      [
        "expo-background-fetch",
        {
          "minimumInterval": 300
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-audio",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true
        }
      ],
      "expo-asset"
    ],
    "sdkVersion": "57.0.0",
    "extra": {

    }
  }
}
