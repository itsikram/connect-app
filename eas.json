{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.18.1",
      "android": {
        "buildType": "apk",
        "image": "sdk-54",
        "resourceClass": "medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "20.18.1",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "image": "sdk-54",
        "resourceClass": "medium"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "20.18.1",
      "android": {
        "buildType": "apk",
        "image": "sdk-54",
        "resourceClass": "medium"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
